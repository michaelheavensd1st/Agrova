# =========================================================================
# Agrovix AgOS API — Environment Template
# =========================================================================

APP_NAME=Agrovix AgOS API
APP_VERSION=0.1.0
APP_ENV=development
API_DEBUG=true

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
API_V1_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Database (PostgreSQL) — asyncpg for app, psycopg2 for Alembic
DATABASE_URL=postgresql+asyncpg://agrovix:agrovix_dev@localhost:5432/agrovix_agos
DATABASE_URL_SYNC=postgresql+psycopg2://agrovix:agrovix_dev@localhost:5432/agrovix_agos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=agrovix-agos
JWT_AUDIENCE=agrovix-agos-clients

# Passwords
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# Cookies (canonical web auth transport)
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_ACCESS_NAME=agrovix_access
COOKIE_REFRESH_NAME=agrovix_refresh

# Email (development sender by default — logs the outbound message)
EMAIL_FROM_ADDRESS=no-reply@agrovix.dev
EMAIL_FROM_NAME=Agrovix AgOS
EMAIL_PROVIDER=log
RESEND_API_KEY=
WEB_APP_URL=http://localhost:3000
VERIFICATION_TOKEN_EXPIRE_HOURS=24
INVITATION_TOKEN_EXPIRE_DAYS=14
PASSWORD_RECOVERY_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RECOVERY_REQUEST_MAX_PER_EMAIL_HOUR=3
PASSWORD_RECOVERY_REQUEST_MAX_PER_IP_HOUR=10
PASSWORD_RECOVERY_REQUEST_WINDOW_SECONDS=3600

# Auth policy — dev-only override; DO NOT enable in production
ALLOW_UNVERIFIED_LOGIN=false

# Trusted-proxy policy — see docs/trusted-proxy.md
# Comma-separated IPs or CIDRs of the reverse-proxy tier we trust to set
# ``X-Forwarded-For``. Empty (default) => header is IGNORED entirely.
TRUSTED_PROXIES=
TRUSTED_PROXY_HEADER=x-forwarded-for

# Rate limiting — Redis-backed in production; fail fast if Redis is missing
RATE_LIMIT_ALLOW_INMEMORY=false
# Login (per email per hour / per IP per hour / rolling window seconds)
LOGIN_MAX_PER_EMAIL_HOUR=10
LOGIN_MAX_PER_IP_HOUR=30
LOGIN_WINDOW_SECONDS=3600
# Invitation accept (per user per hour / per IP per hour)
INVITATION_ACCEPT_MAX_PER_USER_HOUR=20
INVITATION_ACCEPT_MAX_PER_IP_HOUR=60
INVITATION_ACCEPT_WINDOW_SECONDS=3600
# Resend-verification abuse guard
RESEND_VERIFICATION_MAX_PER_EMAIL_HOUR=3
RESEND_VERIFICATION_MAX_PER_IP_HOUR=10
RESEND_VERIFICATION_WINDOW_SECONDS=3600
