{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@agrovix/types": ["../../packages/types/src/index.ts"],
      "@agrovix/utils": ["../../packages/utils/src/index.ts"],
      "@agrovix/validation": ["../../packages/validation/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
