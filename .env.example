# =========================================================================
# Agrovix AgOS — Root Environment Template
# Copy this file to .env for local development.
# =========================================================================

# ---- Global ----
NODE_ENV=development
APP_NAME=agrovix-agos
APP_VERSION=0.1.0

# ---- API (apps/api) ----
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
API_CORS_ORIGINS=http://localhost:3000,http://localhost:19006
API_DEBUG=true

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agrovix
POSTGRES_PASSWORD=agrovix_dev
POSTGRES_DB=agrovix_agos
DATABASE_URL=postgresql+asyncpg://agrovix:agrovix_dev@localhost:5432/agrovix_agos
DATABASE_URL_SYNC=postgresql+psycopg2://agrovix:agrovix_dev@localhost:5432/agrovix_agos

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---- Security / JWT ----
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=agrovix-agos
JWT_AUDIENCE=agrovix-agos-clients
PASSWORD_MIN_LENGTH=8
PASSWORD_RECOVERY_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RECOVERY_REQUEST_MAX_PER_EMAIL_HOUR=3
PASSWORD_RECOVERY_REQUEST_MAX_PER_IP_HOUR=10
PASSWORD_RECOVERY_REQUEST_WINDOW_SECONDS=3600

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=/api-proxy
API_PROXY_TARGET=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=Agrovix AgOS
NEXT_PUBLIC_APP_ENV=development

# ---- Mobile (apps/mobile) ----
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_APP_NAME=Agrovix AgOS
